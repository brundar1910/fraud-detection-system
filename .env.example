# =============================================================================
# FraudShield AI: Configuration (.env)
# Native Windows Environment: Python 3.11 + PostgreSQL 17
# =============================================================================

# PostgreSQL 17 Local Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fraud_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# SQLAlchemy Database Connection URI
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Application & Streaming Configuration (In-Memory / Native, No Kafka/Redis)
ENVIRONMENT=development
LOG_LEVEL=INFO
STREAM_BATCH_SIZE=500
ANOMALY_DETECTION_THRESHOLD=75.0

# FastAPI Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501

# Google Gemini / GenAI API Key (for Autonomous Investigations)
GEMINI_API_KEY=your_gemini_api_key_here
